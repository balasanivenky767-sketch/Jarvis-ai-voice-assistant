# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twilio Voice API Credentials (for Real Outbound Phone Calls)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
JARVIS_USER_PHONE_NUMBER="+1XXXXXXXXXX"
# Optional API Key credentials:
# TWILIO_API_KEY_SID="SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_API_KEY_SECRET="your_api_key_secret_here"

# Telegram Bot API Credentials
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_ALLOWED_USERS="*"
TELEGRAM_WEBHOOK_SECRET="optional_secret_token_here"

# WhatsApp Cloud API (Meta Graph API) Credentials
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="jarvis_meta_verify_token"
WHATSAPP_ALLOWED_NUMBERS="*"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
